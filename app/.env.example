# Optional. With no .env the app uses NEAR testnet and deployments/testnet.json.
# Values are read at build time.

# testnet (default) or mainnet
# NEXT_PUBLIC_NEAR_NETWORK=testnet

# Required on mainnet; default to deployments/testnet.json on testnet.
# NEXT_PUBLIC_CONTRACT_ID=circles.bread-saving-circles.testnet
# NEXT_PUBLIC_TOKEN_ID=usdc.bread-saving-circles.testnet

# Token display; default tUSDC with 6 decimals on testnet, USDC with 6 on mainnet.
# NEXT_PUBLIC_TOKEN_SYMBOL=USDC
# NEXT_PUBLIC_TOKEN_DECIMALS=6

# Account that runs automatic deposits and claims (calls process_due). Defaults to
# bread-keeper.testnet for the committed testnet deployment; elsewhere the automation
# switches are hidden unless this is set.
# NEXT_PUBLIC_KEEPER_ID=bread-keeper.testnet

# Defaults to FastNEAR's free public RPC for the network.
# NEXT_PUBLIC_NEAR_RPC_URL=https://test.rpc.fastnear.com
